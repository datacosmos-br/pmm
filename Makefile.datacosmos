###############################################################################
# Makefile.datacosmos - fork-only PMM build and release helpers.
#
# Keep this file small: common development/build targets stay in the upstream
# Makefiles. These targets only add datacosmos release versioning, an external
# build root, GHCR publishing, and upstream sync helpers.
###############################################################################

SHELL := /bin/bash -o pipefail

PMM_VERSION ?= $(or $(shell git describe --tags --abbrev=0 \
	--match 'v[0-9]*.[0-9]*.[0-9]*' --exclude '*-dc*' \
	| sed 's/^v//'),$(error no upstream stable PMM tag found for PMM_VERSION))

UPSTREAM_BRANCH ?= upstream/v3
UPSTREAM_TARGET ?= head
DIST ?= el9
ROOT_DIR ?= $(abspath $(CURDIR)/../pmm-build-root)
ARTIFACT_DIR ?= $(abspath $(CURDIR)/../pmm-artifacts)
GHCR_NAMESPACE ?= ghcr.io/datacosmos-br
GHCR_USER ?=
DC_VERSION ?= $(PMM_VERSION)-dev
IMAGE_ARCH ?= amd64
DC_TEST_ENV_UP_FLAGS ?= --detach --force-recreate --renew-anon-volumes --remove-orphans
DC_TEST_ENV_WAIT_TIMEOUT ?= 180
DC_PMM_SUBMODULES_REPO ?= https://github.com/datacosmos-br/pmm-submodules.git
DC_PMM_DUMP_REPO ?= https://github.com/datacosmos-br/pmm-dump.git
PMM_SUBMODULES_BRANCH ?= $(or $(shell git config -f .gitmodules submodule.pmm-submodules.branch),$(error .gitmodules missing submodule.pmm-submodules.branch))
DC_RELEASE_COMMIT_PATHS := \
	.gitmodules \
	Makefile.datacosmos \
	.github/workflows/datacosmos-release.yml \
	build/scripts/dc-bump-forks \
	build/scripts/dc-git-status \
	build/scripts/build-client-binary \
	build/scripts/build-client-packages \
	build/scripts/build-client-rpm \
	build/scripts/build-client-source \
	build/scripts/build-server-rpm \
	build/scripts/create-tags \
	build/scripts/install_tarball \
	docs/datacosmos/BUILD.md \
	docs/datacosmos/adrs/0001-no-bypass-build-governance.md \
	docs/datacosmos/clickhouse-epic/PHASE-4-distribution.md \
	AGENTS.md \
	CLAUDE.md \
	agent/AGENTS.md \
	build/AGENTS.md \
	.agents/skills/agent-coordination/SKILL.md \
	.agents/skills/beads/SKILL.md

FULL_VERSION := $(PMM_VERSION)-$(or $(shell git rev-list --count HEAD),$(error git rev-list --count HEAD failed))
CLIENT_IMAGE ?= pmm-local/pmm-client:$(FULL_VERSION)
SERVER_IMAGE ?= pmm-local/pmm-server:$(FULL_VERSION)
CLIENT_PUBLISH_IMAGE ?= $(GHCR_NAMESPACE)/pmm-client:$(DC_VERSION)-$(IMAGE_ARCH)
SERVER_PUBLISH_IMAGE ?= $(GHCR_NAMESPACE)/pmm-server:$(DC_VERSION)-$(IMAGE_ARCH)

export ROOT_DIR
export RPMBUILD_DIST := $(DIST)
export PMM_SUBMODULES_REPO := $(DC_PMM_SUBMODULES_REPO)
export PMM_DUMP_REPO := $(DC_PMM_DUMP_REPO)
export PMM_SUBMODULES_BRANCH
unexport PUSH_DOCKER

define DC_RESOLVE_TAG_SCRIPT
if upstream_ref=$$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null); then :; \
elif upstream_ref=$$(git merge-base HEAD $(UPSTREAM_BRANCH)); then :; \
else echo "Cannot determine upstream sync position against $(UPSTREAM_BRANCH)"; exit 1; fi; \
stable=$$(git tag --points-at "$$upstream_ref" --list 'v[0-9]*.[0-9]*.[0-9]*' | sed -n -E '/^v[0-9]+\.[0-9]+\.[0-9]+$$/p' | sort -V | sed -n '$$p'); \
if [ -n "$$stable" ]; then base="$${stable}-dc"; else base="v3-$$(git show -s --format=%cs "$$upstream_ref")-dc"; fi; \
last=$$(git tag -l "$${base}*" | sed -n "s/^$${base}\([0-9][0-9]*\)$$/\1/p" | sort -n | sed -n '$$p'); \
tag="$$base$$(( $${last:-0} + 1 ))"
endef

.PHONY: dc-upstream
dc-upstream: ## Merge upstream/v3 head, or latest stable tag with UPSTREAM_TARGET=stable
	@set +e; \
	current_branch=$$(git branch --show-current); \
	if [ -n "$$current_branch" ]; then \
		git pull --ff-only origin "$$current_branch"; \
		pull_rc=$$?; \
		if [ $$pull_rc -ne 0 ]; then \
			bash build/scripts/dc-git-status; \
			exit $$pull_rc; \
		fi; \
	fi; \
	bash build/scripts/dc-git-status --sync; \
	sync_rc=$$?; \
	if [ $$sync_rc -ne 0 ]; then \
		bash build/scripts/dc-git-status; \
		exit $$sync_rc; \
	fi; \
	ref="$(UPSTREAM_BRANCH)"; \
	if [ "$(UPSTREAM_TARGET)" = "stable" ]; then \
		ref=$$(git tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$$' | sed -n '1p'); \
	fi; \
	if [ -z "$$ref" ]; then \
		echo "No upstream ref found for UPSTREAM_TARGET=$(UPSTREAM_TARGET)"; \
		exit 1; \
	fi; \
	echo "Merging $$ref"; \
	git merge --no-ff "$$ref"; \
	rc=$$?; \
	bash build/scripts/dc-git-status; \
	exit $$rc

.PHONY: dc-sync
dc-sync: dc-upstream

.PHONY: dc-status
dc-status: ## Show Git-derived upstream, tag, bump, and worktree status
	@bash build/scripts/dc-git-status --sync

.PHONY: dc-doctor
dc-doctor: ## Validate build preconditions: no merge, clean tree, immutable fork pins, sane submodule recursion
	@rc=0; \
	if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 || git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then \
		echo "FAIL: merge/cherry-pick in progress"; rc=1; \
	else echo "OK: no merge/cherry-pick in progress"; fi; \
	dirty=$$(git status --porcelain --untracked-files=no -- . ':(exclude)pmm-submodules'); \
	if [ -n "$$dirty" ]; then echo "FAIL: uncommitted tracked changes:"; echo "$$dirty"; rc=1; \
	else echo "OK: working tree clean (benign pmm-submodules pointer churn ignored)"; fi; \
	sub_sha=$$(git rev-parse HEAD:pmm-submodules 2>/dev/null); \
	if [ -z "$$sub_sha" ]; then echo "FAIL: pmm-submodules gitlink missing"; rc=1; \
	else echo "OK: pmm-submodules pinned at immutable gitlink $$sub_sha"; fi; \
	dump_branch=$$(git -C pmm-submodules config -f .gitmodules submodule.pmm-dump.branch 2>/dev/null || true); \
	case "$$dump_branch" in \
		v[0-9]*) echo "OK: pmm-dump pinned to tag $$dump_branch" ;; \
		'') echo "WARN: pmm-dump branch pin not readable (submodule not initialized?)" ;; \
		*) echo "FAIL: pmm-dump pinned to moving branch '$$dump_branch' (expected a vX.Y.Z-dcN tag)"; rc=1 ;; \
	esac; \
	if git -C pmm-submodules submodule status sources/pmm/src/github.com/percona/pmm 2>/dev/null | grep -q '^[^-]'; then \
		echo "WARN: circular pmm sub-submodule is checked out (must stay uninitialized to avoid recursion)"; \
	else echo "OK: circular pmm sub-submodule not initialized"; fi; \
	exit $$rc

.PHONY: dc-sync-upstream
dc-sync-upstream: ## Dry-run an upstream sync (APPLY=Y to merge); NEVER runs implicitly during a build
	@if [ "$(APPLY)" = "Y" ]; then \
		echo "Applying upstream sync (UPSTREAM_TARGET=$(UPSTREAM_TARGET))..."; \
		$(MAKE) dc-upstream; \
	else \
		echo "DRY-RUN — set APPLY=Y to merge upstream. These datacosmos files must survive any sync:"; \
		printf '  %s\n' $(DC_RELEASE_COMMIT_PATHS); \
		echo "Current upstream sync position:"; \
		bash build/scripts/dc-git-status --sync || true; \
	fi

.PHONY: dc-test-env-up
dc-test-env-up: ## Start upstream service containers used by local tests
	@if [[ "$${DOCKER_HOST:-}" == tcp://* ]]; then \
		service_host="$${PMM_TEST_SERVICE_HOST:-$${DOCKER_HOST#tcp://}}"; \
		service_host="$${service_host%%:*}"; \
		if [[ "$$service_host" == "localhost" || "$$service_host" == 127.* || "$$service_host" == "::1" ]]; then \
			PMM_TEST_BIND_HOST="$${PMM_TEST_BIND_HOST:-0.0.0.0}" PMM_TEST_SERVICE_HOST="$$service_host" $(MAKE) -C agent env-up ENV_UP_FLAGS="$(DC_TEST_ENV_UP_FLAGS)"; \
		else \
			PMM_TEST_BIND_HOST="$${PMM_TEST_BIND_HOST:-0.0.0.0}" PMM_TEST_SERVICE_HOST="$$service_host" PMM_TEST_SERVICE_EXTRA_HOST="$$service_host:host-gateway" $(MAKE) -C agent env-up ENV_UP_FLAGS="$(DC_TEST_ENV_UP_FLAGS)"; \
		fi; \
	else \
		$(MAKE) -C agent env-up ENV_UP_FLAGS="$(DC_TEST_ENV_UP_FLAGS)"; \
	fi

.PHONY: dc-test-env-wait
dc-test-env-wait: ## Wait for upstream service containers used by local tests
	@set -euo pipefail; \
	valkey_password=$$(sed -n -E 's/^requirepass "([^"]+)"/\1/p' agent/utils/tests/testdata/valkey/valkey.conf); \
	if [ -z "$$valkey_password" ]; then \
		echo "Cannot read Valkey password from agent/utils/tests/testdata/valkey/valkey.conf"; \
		exit 1; \
	fi; \
	probe_ready() { \
		local rows reply status exit_code; \
		case "$$1" in \
			test_db) \
				status=$$(docker inspect --format '{{.State.Status}}' pmm-agent_test_db 2>/dev/null) || return 1; \
				exit_code=$$(docker inspect --format '{{.State.ExitCode}}' pmm-agent_test_db 2>/dev/null) || return 1; \
				[ "$$status" = "exited" ] && [ "$$exit_code" = "0" ]; \
				;; \
			mysql) \
				rows=$$(docker exec -e MYSQL_PWD=root-password pmm-agent_mysql mysql --protocol=TCP --host=127.0.0.1 --port=3306 -uroot world -NBe 'SELECT COUNT(*) FROM city' 2>/dev/null) || return 1; \
				[[ "$$rows" =~ ^[0-9]+$$ ]] && [ "$$rows" -gt 0 ]; \
				;; \
			postgres) \
				rows=$$(docker exec -e PGPASSWORD=pmm-agent-password pmm-agent_postgres psql -U pmm-agent -d pmm-agent -Atc 'SELECT COUNT(*) FROM city' 2>/dev/null) || return 1; \
				[[ "$$rows" =~ ^[0-9]+$$ ]] && [ "$$rows" -gt 0 ]; \
				;; \
			valkey) \
				reply=$$(docker exec -e REDISCLI_AUTH="$$valkey_password" pmm-agent_valkey valkey-cli ping 2>/dev/null) || return 1; \
				[ "$$reply" = "PONG" ]; \
				;; \
			clickhouse) \
				reply=$$(docker exec pmm-agent_clickhouse clickhouse-client --user default --password clickhouse --query 'SELECT 1' 2>/dev/null) || return 1; \
				[ "$$reply" = "1" ]; \
				;; \
			mongo) \
				reply=$$(docker exec pmm-agent_mongo mongosh --quiet -u root -p root-password --authenticationDatabase admin --eval 'db.adminCommand({ ping: 1 }).ok' 2>/dev/null) || return 1; \
				[ "$$reply" = "1" ]; \
				;; \
			mongo_tls) \
				reply=$$(docker exec pmm-agent_mongo_with_tls mongosh --quiet --tls --tlsAllowInvalidCertificates --tlsCertificateKeyFile /etc/tls/certificates/client.pem --tlsCAFile /etc/tls/certificates/ca.crt --host localhost --port 27017 --eval 'db.adminCommand({ ping: 1 }).ok' 2>/dev/null) || return 1; \
				[ "$$reply" = "1" ]; \
				;; \
			mongo_noauth) \
				reply=$$(docker exec pmm-agent_mongonoauth mongosh --quiet --eval 'db.adminCommand({ ping: 1 }).ok' 2>/dev/null) || return 1; \
				[ "$$reply" = "1" ]; \
				;; \
			mongo_repl) \
				reply=$$(docker exec pmm-agent_mongorepl mongosh --quiet --port 27020 --eval 'rs.status().ok' 2>/dev/null) || return 1; \
				[ "$$reply" = "1" ]; \
				;; \
			mongo_repl_tls) \
				reply=$$(docker exec pmm-agent_mongorepl_with_tls mongosh --quiet --tls --tlsAllowInvalidCertificates --tlsCertificateKeyFile /etc/tls/certificates/client.pem --tlsCAFile /etc/tls/certificates/ca.crt --host localhost --port 27022 --eval 'rs.status().ok' 2>/dev/null) || return 1; \
				[ "$$reply" = "1" ]; \
				;; \
			pmm_server) \
				status=$$(docker inspect --format '{{.State.Health.Status}}' pmm-server 2>/dev/null) || return 1; \
				[ "$$status" = "healthy" ]; \
				;; \
			sysbench) \
				status=$$(docker inspect --format '{{.State.Status}}' pmm-agent_sysbench 2>/dev/null) || return 1; \
				[ "$$status" = "running" ]; \
				;; \
			*) \
				echo "Unknown readiness probe: $$1"; \
				return 2; \
				;; \
		esac; \
	}; \
	wait_probe() { \
		local probe label deadline; \
		probe="$$1"; \
		label="$$2"; \
		deadline=$$((SECONDS + $(DC_TEST_ENV_WAIT_TIMEOUT))); \
		printf 'Waiting for %s\n' "$$label"; \
		until probe_ready "$$probe"; do \
			if [ "$$SECONDS" -ge "$$deadline" ]; then \
				echo "$$label not ready within $(DC_TEST_ENV_WAIT_TIMEOUT)s"; \
				exit 1; \
			fi; \
			sleep 2; \
		done; \
		printf '%s ready\n' "$$label"; \
	}; \
	wait_probe test_db "test data import"; \
	wait_probe mysql "MySQL test data"; \
	wait_probe postgres "PostgreSQL test data"; \
	wait_probe valkey "Valkey"; \
	wait_probe clickhouse "ClickHouse"; \
	wait_probe mongo "MongoDB"; \
	wait_probe mongo_tls "MongoDB TLS"; \
	wait_probe mongo_noauth "MongoDB no-auth"; \
	wait_probe mongo_repl "MongoDB replica set"; \
	wait_probe mongo_repl_tls "MongoDB TLS replica set"; \
	wait_probe pmm_server "PMM Server"; \
	wait_probe sysbench "sysbench"

.PHONY: dc-test-agent
dc-test-agent: ## Run agent tests against upstream service containers
	$(MAKE) dc-test-env-up
	$(MAKE) dc-test-env-wait
	$(MAKE) -C agent test

.PHONY: dc-test-qan
dc-test-qan: ## Run QAN tests against its upstream ClickHouse test container
	@if docker container inspect pmm-clickhouse-test >/dev/null 2>&1; then \
		$(MAKE) -C qan-api2 test-env-down; \
	fi
	$(MAKE) -C qan-api2 test-env-up
	$(MAKE) -C qan-api2 test

.PHONY: dc-test-clickhouse
dc-test-clickhouse: ## Run ClickHouse unit and Docker matrix tests
	$(MAKE) test-clickhouse-unit
	$(MAKE) test-clickhouse-matrix

.PHONY: dc-test-local
dc-test-local: check-all dc-test-agent dc-test-qan dc-test-clickhouse ## Run local PMM checks with containerized daemons

.PHONY: dc-bump
dc-bump: ## Update pmm-submodules/pmm-dump fork refs; set DC_BUMP_TARGET=stable|head
	@set +e; \
	DC_BUMP_TARGET="$${DC_BUMP_TARGET:-stable}" \
	PMM_VERSION="$(PMM_VERSION)" \
	DC_PMM_SUBMODULES_REPO="$(DC_PMM_SUBMODULES_REPO)" \
	DC_PMM_DUMP_REPO="$(DC_PMM_DUMP_REPO)" \
	bash build/scripts/dc-bump-forks; \
	rc=$$?; \
	bash build/scripts/dc-git-status; \
	exit $$rc

.PHONY: dc-bump-stable
dc-bump-stable: ## Update fork refs for the latest stable PMM version
	$(MAKE) dc-bump DC_BUMP_TARGET=stable

.PHONY: dc-bump-head
dc-bump-head: ## Update fork refs for datacosmos v3 head
	$(MAKE) dc-bump DC_BUMP_TARGET=head

.PHONY: dc-next
dc-next: .dc-fetch-tags ## Print next release tag inferred from upstream sync position
	@$(DC_RESOLVE_TAG_SCRIPT); \
	printf "%s\n" "$$tag"

.PHONY: dc-release
dc-release: .dc-clean-worktree .dc-fetch-tags ## Create and push next release tag inferred from upstream sync position
	@$(DC_RESOLVE_TAG_SCRIPT); \
	git tag -a "$$tag" -m "datacosmos PMM $$tag (@ $$(git rev-parse --short HEAD))"; \
	git push origin "$$tag"

.PHONY: dc-tag
dc-tag: dc-release

.PHONY: dc-build
dc-build: .dc-guard .dc-prepare ## Build native linux images and collect artifacts
	# build-server already invokes build-client; pass both tags to avoid a duplicate client build.
	cd $(ROOT_DIR) && ROOT_DIR=$(ROOT_DIR) RPMBUILD_DIST=$(DIST) SKIP_S3_CACHE=1 DOCKER_CLIENT_TAG=$(CLIENT_IMAGE) DOCKER_TAG=$(SERVER_IMAGE) \
		$(CURDIR)/build/scripts/build-server
	$(MAKE) dc-artifacts

.PHONY: dc-publish
dc-publish: .dc-login ## Publish images built by dc-build to ghcr.io/datacosmos-br
	docker tag $(CLIENT_IMAGE) $(CLIENT_PUBLISH_IMAGE)
	docker tag $(SERVER_IMAGE) $(SERVER_PUBLISH_IMAGE)
	docker push $(CLIENT_PUBLISH_IMAGE)
	docker push $(SERVER_PUBLISH_IMAGE)

.PHONY: dc-artifacts
dc-artifacts:
	mkdir -p $(ARTIFACT_DIR)/server-rpms
	test -d $(ROOT_DIR)/results
	cp -a $(ROOT_DIR)/results/. $(ARTIFACT_DIR)/
	test -d $(ROOT_DIR)/tmp/pmm-server/RPMS
	rpm_count=$$(find $(ROOT_DIR)/tmp/pmm-server/RPMS -name '*.rpm' -type f | wc -l); \
	if [ "$$rpm_count" -eq 0 ]; then \
		echo "No server RPM artifacts found in $(ROOT_DIR)/tmp/pmm-server/RPMS"; \
		exit 1; \
	fi; \
	find $(ROOT_DIR)/tmp/pmm-server/RPMS -name '*.rpm' -type f \
		-exec cp -f {} $(ARTIFACT_DIR)/server-rpms/ \;
	echo "Artifacts in $(ARTIFACT_DIR)"

.PHONY: dc-clean
dc-clean: ## Remove datacosmos external build and artifact dirs
	rm -rf $(ROOT_DIR) $(ARTIFACT_DIR)

.PHONY: .dc-prepare
.dc-prepare:
	# Bounded submodule init: the pmm <-> pmm-submodules graph is circular
	# (pmm-submodules/sources/pmm is percona/pmm, which re-references
	# pmm-submodules), so a plain `--recursive` recurses forever. Init the top
	# level, then recurse into pmm-submodules' real leaves while skipping the
	# circular `pmm` sub-submodule (the build re-clones pmm from $(CURDIR) below).
	git submodule update --init --jobs 10
	git -C pmm-submodules -c submodule.pmm.update=none submodule update --init --recursive --jobs 10
	rm -rf $(ROOT_DIR)/sources $(ROOT_DIR)/tmp/source $(ROOT_DIR)/tmp/binary
	mkdir -p $(ROOT_DIR)/sources $(ROOT_DIR)/tmp $(ROOT_DIR)/results $(ARTIFACT_DIR)
	chmod 0777 $(ROOT_DIR)/tmp $(ROOT_DIR)/results
	echo "$(PMM_VERSION)" > $(ROOT_DIR)/VERSION
	for d in $(CURDIR)/pmm-submodules/sources/*; do \
		ln -sfn "$$d" "$(ROOT_DIR)/sources/$$(basename $$d)"; \
	done
	ln -sfn $(CURDIR)/pmm-submodules $(ROOT_DIR)/sources/pmm-submodules
	rm -rf $(ROOT_DIR)/sources/pmm
	mkdir -p $(ROOT_DIR)/sources/pmm/src/github.com/percona
	git clone --local --no-checkout $(CURDIR) $(ROOT_DIR)/sources/pmm/src/github.com/percona/pmm
	git -C $(ROOT_DIR)/sources/pmm/src/github.com/percona/pmm checkout --detach $$(git rev-parse HEAD)

.PHONY: .dc-guard
.dc-guard: ## Fail-fast: no merge/cherry-pick in progress and no uncommitted tracked changes
	@if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 || git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then \
		echo "ERROR: merge/cherry-pick in progress; resolve+commit before building (dc-build clones HEAD)."; \
		exit 1; \
	fi
	@dirty=$$(git status --porcelain --untracked-files=no -- . ':(exclude)pmm-submodules'); \
	if [ -n "$$dirty" ]; then \
		echo "ERROR: uncommitted tracked changes; dc-build clones HEAD and would SILENTLY ignore them. Commit or stash first:"; \
		echo "$$dirty"; \
		exit 1; \
	fi

.PHONY: .dc-clean-worktree
.dc-clean-worktree:
	@if git rev-parse -q --verify MERGE_HEAD >/dev/null; then \
		echo "Merge in progress; commit the upstream sync before dc-release"; \
		exit 1; \
	fi
	@if [ -n "$$(git status --porcelain -- $(DC_RELEASE_COMMIT_PATHS))" ]; then \
		echo "Release files have uncommitted changes; commit before dc-release"; \
		git status --short -- $(DC_RELEASE_COMMIT_PATHS); \
		exit 1; \
	fi

.PHONY: .dc-fetch-tags
.dc-fetch-tags:
	@bash build/scripts/dc-git-status --sync-only --quiet

.PHONY: .dc-login
.dc-login:
	@if [ -n "$$GITHUB_ACTIONS" ]; then \
		echo "$$GH_TOKEN" | docker login ghcr.io -u "$$GITHUB_ACTOR" --password-stdin; \
	elif [ -n "$$GHCR_TOKEN" ]; then \
		: "$${GHCR_USER:?set GHCR_USER for local ghcr.io login}"; \
		echo "$$GHCR_TOKEN" | docker login ghcr.io -u "$$GHCR_USER" --password-stdin; \
	else \
		: "$${GHCR_USER:?set GHCR_USER for local ghcr.io login}"; \
		gh auth token | docker login ghcr.io -u "$$GHCR_USER" --password-stdin; \
	fi
