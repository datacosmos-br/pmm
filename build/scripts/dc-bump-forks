#!/usr/bin/env bash

set -euo pipefail

fail() {
    echo "dc-bump-forks: $*" >&2
    exit 1
}

is_sha() {
    [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]
}

require_datacosmos_repo() {
    local repo=$1
    local expected=$2

    case "${repo}" in
        https://github.com/datacosmos-br/${expected}.git|https://github.com/datacosmos-br/${expected}|git@github.com:datacosmos-br/${expected}.git)
            ;;
        *)
            fail "${expected} must resolve from datacosmos-br, got ${repo}"
            ;;
    esac
}

latest_stable_version() {
    local tag

    tag=$(git tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sed -n '1p' || true)
    if [ -z "${tag}" ]; then
        fail "no stable PMM tag found; set PMM_VERSION or DC_PMM_VERSION"
    fi
    printf '%s\n' "${tag#v}"
}

resolve_local_ref() {
    local repo_path=$1
    local ref_namespace=$2
    local ref=$3
    local sha

    if is_sha "${ref}"; then
        printf '%s\n' "${ref}"
        return
    fi

    if sha=$(git -C "${repo_path}" rev-parse -q --verify "refs/remotes/${ref_namespace}/${ref}^{commit}" 2>/dev/null); then
        printf '%s\n' "${sha}"
        return
    fi

    if sha=$(git -C "${repo_path}" rev-parse -q --verify "refs/tags/${ref}^{commit}" 2>/dev/null); then
        printf '%s\n' "${sha}"
        return
    fi

    fail "ref ${ref} was not found in ${repo_path}"
}

fetch_repo_refs() {
    local repo_path=$1
    local ref_namespace=$2
    local repo=$3

    git -C "${repo_path}" fetch --quiet --prune "${repo}" \
        "+refs/heads/*:refs/remotes/${ref_namespace}/*" \
        "+refs/tags/*:refs/tags/*"
}

repo_root=$(git rev-parse --show-toplevel)
cd "${repo_root}"

git fetch -q origin --tags --prune
git fetch -q upstream --tags --prune

target=${DC_BUMP_TARGET:-stable}
submodules_repo=${DC_PMM_SUBMODULES_REPO:-https://github.com/datacosmos-br/pmm-submodules.git}
dump_repo=${DC_PMM_DUMP_REPO:-https://github.com/datacosmos-br/pmm-dump.git}

require_datacosmos_repo "${submodules_repo}" pmm-submodules
require_datacosmos_repo "${dump_repo}" pmm-dump

case "${target}" in
    stable)
        pmm_version=${DC_PMM_VERSION:-${PMM_VERSION:-}}
        if [ -z "${pmm_version}" ]; then
            pmm_version=$(latest_stable_version)
        fi
        submodules_ref=${DC_PMM_SUBMODULES_REF:-pmm-${pmm_version}}
        ;;
    head|v3)
        pmm_version=v3
        submodules_ref=${DC_PMM_SUBMODULES_REF:-v3}
        ;;
    *)
        fail "DC_BUMP_TARGET must be stable or head, got ${target}"
        ;;
esac

git submodule update --init pmm-submodules
fetch_repo_refs pmm-submodules datacosmos-bump "${submodules_repo}"
submodules_sha=$(resolve_local_ref pmm-submodules datacosmos-bump "${submodules_ref}")

echo "DC_BUMP_TARGET=${target}"
echo "PMM_VERSION=${pmm_version}"
echo "PMM_SUBMODULES_REPO=${submodules_repo}"
echo "PMM_SUBMODULES_REF=${submodules_ref}"
echo "PMM_SUBMODULES_COMMIT=${submodules_sha}"
echo "PMM_DUMP_REPO=${dump_repo}"
echo "PMM_SUBMODULES_AVAILABLE_REFS:"
git -C pmm-submodules for-each-ref --count=8 --sort=-committerdate --format='  %(refname:short) %(objectname:short)' \
    refs/remotes/datacosmos-bump/pmm-* refs/remotes/datacosmos-bump/v3

if [ "${DC_DRY_RUN:-0}" = "1" ]; then
    exit 0
fi

git config -f .gitmodules submodule.pmm-submodules.url "${submodules_repo}"
if ! is_sha "${submodules_ref}"; then
    git config -f .gitmodules submodule.pmm-submodules.branch "${submodules_ref}"
fi

git submodule sync -- pmm-submodules
git submodule update --init pmm-submodules
git -C pmm-submodules remote set-url origin "${submodules_repo}"
git -C pmm-submodules fetch -q origin --tags
git -C pmm-submodules checkout --detach "${submodules_sha}"

configured_dump_repo=$(git -C pmm-submodules config -f .gitmodules submodule.pmm-dump.url)
if [ "${configured_dump_repo}" != "${dump_repo}" ]; then
    fail "pmm-submodules ${submodules_ref} points pmm-dump at ${configured_dump_repo}, expected ${dump_repo}"
fi

git -C pmm-submodules submodule sync --recursive
git -C pmm-submodules submodule update --init --recursive sources/pmm-dump
git -C pmm-submodules/sources/pmm-dump remote set-url origin "${dump_repo}"

actual_dump_repo=$(git -C pmm-submodules/sources/pmm-dump remote get-url origin)
if [ "${actual_dump_repo}" != "${dump_repo}" ]; then
    fail "pmm-dump origin is ${actual_dump_repo}, expected ${dump_repo}"
fi

echo "PMM_SUBMODULES_VERSION=$(git -C pmm-submodules describe --tags --always)"
echo "PMM_DUMP_COMMIT=$(git -C pmm-submodules/sources/pmm-dump rev-parse HEAD)"
echo "PMM_DUMP_VERSION=$(git -C pmm-submodules/sources/pmm-dump describe --tags --always)"
