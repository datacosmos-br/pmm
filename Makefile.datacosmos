###############################################################################
# Makefile.datacosmos - fork-only PMM build and release helpers.
#
# Keep this file small: common development/build targets stay in the upstream
# Makefiles. These targets only add datacosmos release versioning, an external
# build root, GHCR publishing, and upstream sync helpers.
###############################################################################

SHELL := /bin/bash -o pipefail

PMM_VERSION ?= $(or $(shell git describe --tags --abbrev=0 \
	--match 'v[0-9]*.[0-9]*.[0-9]*' --exclude '*-dc*' \
	| sed 's/^v//'),$(error no upstream stable PMM tag found for PMM_VERSION))

UPSTREAM_BRANCH ?= upstream/v3
UPSTREAM_TARGET ?= head
DIST ?= el9
ROOT_DIR ?= $(abspath $(CURDIR)/../pmm-build-root)
ARTIFACT_DIR ?= $(abspath $(CURDIR)/../pmm-artifacts)
GHCR_NAMESPACE ?= ghcr.io/datacosmos-br
GHCR_USER ?=
DC_VERSION ?= $(PMM_VERSION)-dev
IMAGE_ARCH ?= amd64
DC_PMM_SUBMODULES_REPO ?= https://github.com/datacosmos-br/pmm-submodules.git
DC_PMM_DUMP_REPO ?= https://github.com/datacosmos-br/pmm-dump.git
PMM_SUBMODULES_BRANCH ?= $(or $(shell git config -f .gitmodules submodule.pmm-submodules.branch),$(error .gitmodules missing submodule.pmm-submodules.branch))
DC_RELEASE_COMMIT_PATHS := \
	.gitmodules \
	Makefile.datacosmos \
	.github/workflows/datacosmos-release.yml \
	build/scripts/dc-bump-forks \
	build/scripts/dc-git-status \
	build/scripts/build-client-binary \
	build/scripts/build-client-packages \
	build/scripts/build-client-rpm \
	build/scripts/build-client-source \
	build/scripts/build-server-rpm \
	build/scripts/create-tags \
	build/scripts/install_tarball \
	docs/datacosmos/BUILD.md \
	docs/datacosmos/adrs/0001-no-bypass-build-governance.md \
	docs/datacosmos/clickhouse-epic/PHASE-4-distribution.md \
	AGENTS.md \
	CLAUDE.md \
	agent/AGENTS.md \
	build/AGENTS.md \
	.agents/skills/agent-coordination/SKILL.md \
	.agents/skills/beads/SKILL.md

FULL_VERSION := $(PMM_VERSION)-$(or $(shell git rev-list --count HEAD),$(error git rev-list --count HEAD failed))
CLIENT_IMAGE ?= pmm-local/pmm-client:$(FULL_VERSION)
SERVER_IMAGE ?= pmm-local/pmm-server:$(FULL_VERSION)
CLIENT_PUBLISH_IMAGE ?= $(GHCR_NAMESPACE)/pmm-client:$(DC_VERSION)-$(IMAGE_ARCH)
SERVER_PUBLISH_IMAGE ?= $(GHCR_NAMESPACE)/pmm-server:$(DC_VERSION)-$(IMAGE_ARCH)

export ROOT_DIR
export RPMBUILD_DIST := $(DIST)
export PMM_SUBMODULES_REPO := $(DC_PMM_SUBMODULES_REPO)
export PMM_DUMP_REPO := $(DC_PMM_DUMP_REPO)
export PMM_SUBMODULES_BRANCH
unexport PUSH_DOCKER

define DC_RESOLVE_TAG_SCRIPT
if upstream_ref=$$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null); then :; \
elif upstream_ref=$$(git merge-base HEAD $(UPSTREAM_BRANCH)); then :; \
else echo "Cannot determine upstream sync position against $(UPSTREAM_BRANCH)"; exit 1; fi; \
stable=$$(git tag --points-at "$$upstream_ref" --list 'v[0-9]*.[0-9]*.[0-9]*' | sed -n -E '/^v[0-9]+\.[0-9]+\.[0-9]+$$/p' | sort -V | sed -n '$$p'); \
if [ -n "$$stable" ]; then base="$${stable}-dc"; else base="v3-$$(git show -s --format=%cs "$$upstream_ref")-dc"; fi; \
last=$$(git tag -l "$${base}*" | sed -n "s/^$${base}\([0-9][0-9]*\)$$/\1/p" | sort -n | sed -n '$$p'); \
tag="$$base$$(( $${last:-0} + 1 ))"
endef

.PHONY: dc-upstream
dc-upstream: ## Merge upstream/v3 head, or latest stable tag with UPSTREAM_TARGET=stable
	@set +e; \
	current_branch=$$(git branch --show-current); \
	if [ -n "$$current_branch" ]; then \
		git pull --ff-only origin "$$current_branch"; \
		pull_rc=$$?; \
		if [ $$pull_rc -ne 0 ]; then \
			bash build/scripts/dc-git-status; \
			exit $$pull_rc; \
		fi; \
	fi; \
	bash build/scripts/dc-git-status --sync; \
	sync_rc=$$?; \
	if [ $$sync_rc -ne 0 ]; then \
		bash build/scripts/dc-git-status; \
		exit $$sync_rc; \
	fi; \
	ref="$(UPSTREAM_BRANCH)"; \
	if [ "$(UPSTREAM_TARGET)" = "stable" ]; then \
		ref=$$(git tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$$' | sed -n '1p'); \
	fi; \
	if [ -z "$$ref" ]; then \
		echo "No upstream ref found for UPSTREAM_TARGET=$(UPSTREAM_TARGET)"; \
		exit 1; \
	fi; \
	echo "Merging $$ref"; \
	git merge --no-ff "$$ref"; \
	rc=$$?; \
	bash build/scripts/dc-git-status; \
	exit $$rc

.PHONY: dc-sync
dc-sync: dc-upstream

.PHONY: dc-status
dc-status: ## Show Git-derived upstream, tag, bump, and worktree status
	@bash build/scripts/dc-git-status --sync

.PHONY: dc-test-env-up
dc-test-env-up: ## Start upstream service containers used by local tests
	$(MAKE) -C agent env-up

.PHONY: dc-test-agent
dc-test-agent: dc-test-env-up ## Run agent tests against upstream service containers
	$(MAKE) -C agent test

.PHONY: dc-test-qan
dc-test-qan: ## Run QAN tests against its upstream ClickHouse test container
	@if docker container inspect pmm-clickhouse-test >/dev/null 2>&1; then \
		$(MAKE) -C qan-api2 test-env-down; \
	fi
	$(MAKE) -C qan-api2 test-env-up
	$(MAKE) -C qan-api2 test

.PHONY: dc-test-clickhouse
dc-test-clickhouse: ## Run ClickHouse unit and Docker matrix tests
	$(MAKE) test-clickhouse-unit
	$(MAKE) test-clickhouse-matrix

.PHONY: dc-test-local
dc-test-local: check-all dc-test-agent dc-test-qan dc-test-clickhouse ## Run local PMM checks with containerized daemons

.PHONY: dc-bump
dc-bump: ## Update pmm-submodules/pmm-dump fork refs; set DC_BUMP_TARGET=stable|head
	@set +e; \
	DC_BUMP_TARGET="$${DC_BUMP_TARGET:-stable}" \
	PMM_VERSION="$(PMM_VERSION)" \
	DC_PMM_SUBMODULES_REPO="$(DC_PMM_SUBMODULES_REPO)" \
	DC_PMM_DUMP_REPO="$(DC_PMM_DUMP_REPO)" \
	bash build/scripts/dc-bump-forks; \
	rc=$$?; \
	bash build/scripts/dc-git-status; \
	exit $$rc

.PHONY: dc-bump-stable
dc-bump-stable: ## Update fork refs for the latest stable PMM version
	$(MAKE) dc-bump DC_BUMP_TARGET=stable

.PHONY: dc-bump-head
dc-bump-head: ## Update fork refs for datacosmos v3 head
	$(MAKE) dc-bump DC_BUMP_TARGET=head

.PHONY: dc-next
dc-next: .dc-fetch-tags ## Print next release tag inferred from upstream sync position
	@$(DC_RESOLVE_TAG_SCRIPT); \
	printf "%s\n" "$$tag"

.PHONY: dc-release
dc-release: .dc-clean-worktree .dc-fetch-tags ## Create and push next release tag inferred from upstream sync position
	@$(DC_RESOLVE_TAG_SCRIPT); \
	git tag -a "$$tag" -m "datacosmos PMM $$tag (@ $$(git rev-parse --short HEAD))"; \
	git push origin "$$tag"

.PHONY: dc-tag
dc-tag: dc-release

.PHONY: dc-build
dc-build: .dc-prepare ## Build linux/amd64 images and collect artifacts
	cd $(ROOT_DIR) && ROOT_DIR=$(ROOT_DIR) DOCKER_CLIENT_TAG=$(CLIENT_IMAGE) \
		$(CURDIR)/build/scripts/build-client
	cd $(ROOT_DIR) && ROOT_DIR=$(ROOT_DIR) RPMBUILD_DIST=$(DIST) DOCKER_TAG=$(SERVER_IMAGE) \
		$(CURDIR)/build/scripts/build-server
	$(MAKE) dc-artifacts

.PHONY: dc-publish
dc-publish: .dc-login ## Publish images built by dc-build to ghcr.io/datacosmos-br
	docker tag $(CLIENT_IMAGE) $(CLIENT_PUBLISH_IMAGE)
	docker tag $(SERVER_IMAGE) $(SERVER_PUBLISH_IMAGE)
	docker push $(CLIENT_PUBLISH_IMAGE)
	docker push $(SERVER_PUBLISH_IMAGE)

.PHONY: dc-artifacts
dc-artifacts:
	mkdir -p $(ARTIFACT_DIR)/server-rpms
	test -d $(ROOT_DIR)/results
	cp -a $(ROOT_DIR)/results/. $(ARTIFACT_DIR)/
	test -d $(ROOT_DIR)/tmp/pmm-server/RPMS
	rpm_count=$$(find $(ROOT_DIR)/tmp/pmm-server/RPMS -name '*.rpm' -type f | wc -l); \
	if [ "$$rpm_count" -eq 0 ]; then \
		echo "No server RPM artifacts found in $(ROOT_DIR)/tmp/pmm-server/RPMS"; \
		exit 1; \
	fi; \
	find $(ROOT_DIR)/tmp/pmm-server/RPMS -name '*.rpm' -type f \
		-exec cp -f {} $(ARTIFACT_DIR)/server-rpms/ \;
	echo "Artifacts in $(ARTIFACT_DIR)"

.PHONY: dc-clean
dc-clean: ## Remove datacosmos external build and artifact dirs
	rm -rf $(ROOT_DIR) $(ARTIFACT_DIR)

.PHONY: .dc-prepare
.dc-prepare:
	git submodule update --init --recursive --jobs 10
	rm -rf $(ROOT_DIR)/sources $(ROOT_DIR)/tmp/source $(ROOT_DIR)/tmp/binary
	mkdir -p $(ROOT_DIR)/sources $(ROOT_DIR)/tmp $(ROOT_DIR)/results $(ARTIFACT_DIR)
	chmod 0777 $(ROOT_DIR)/tmp $(ROOT_DIR)/results
	echo "$(PMM_VERSION)" > $(ROOT_DIR)/VERSION
	for d in $(CURDIR)/pmm-submodules/sources/*; do \
		ln -sfn "$$d" "$(ROOT_DIR)/sources/$$(basename $$d)"; \
	done
	ln -sfn $(CURDIR)/pmm-submodules $(ROOT_DIR)/sources/pmm-submodules
	rm -rf $(ROOT_DIR)/sources/pmm
	mkdir -p $(ROOT_DIR)/sources/pmm/src/github.com/percona
	git clone --local --no-checkout $(CURDIR) $(ROOT_DIR)/sources/pmm/src/github.com/percona/pmm
	git -C $(ROOT_DIR)/sources/pmm/src/github.com/percona/pmm checkout --detach $$(git rev-parse HEAD)

.PHONY: .dc-clean-worktree
.dc-clean-worktree:
	@if git rev-parse -q --verify MERGE_HEAD >/dev/null; then \
		echo "Merge in progress; commit the upstream sync before dc-release"; \
		exit 1; \
	fi
	@if [ -n "$$(git status --porcelain -- $(DC_RELEASE_COMMIT_PATHS))" ]; then \
		echo "Release files have uncommitted changes; commit before dc-release"; \
		git status --short -- $(DC_RELEASE_COMMIT_PATHS); \
		exit 1; \
	fi

.PHONY: .dc-fetch-tags
.dc-fetch-tags:
	@bash build/scripts/dc-git-status --sync-only --quiet

.PHONY: .dc-login
.dc-login:
	@if [ -n "$$GITHUB_ACTIONS" ]; then \
		echo "$$GH_TOKEN" | docker login ghcr.io -u "$$GITHUB_ACTOR" --password-stdin; \
	elif [ -n "$$GHCR_TOKEN" ]; then \
		: "$${GHCR_USER:?set GHCR_USER for local ghcr.io login}"; \
		echo "$$GHCR_TOKEN" | docker login ghcr.io -u "$$GHCR_USER" --password-stdin; \
	else \
		: "$${GHCR_USER:?set GHCR_USER for local ghcr.io login}"; \
		gh auth token | docker login ghcr.io -u "$$GHCR_USER" --password-stdin; \
	fi
