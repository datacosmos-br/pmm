#!/bin/bash

set -o errexit
set -o xtrace

. $(dirname $0)/vars

fail() {
    echo "build-client-binary: $*" >&2
    exit 1
}

component_archive() {
    local component=$1
    local archives=()

    shopt -s nullglob
    case "${component}" in
        pmm)
            archives=("${source_dir}"/pmm-[0-9a-f]*.tar.gz)
            ;;
        *)
            archives=("${source_dir}"/${component}-*.tar.gz)
            ;;
    esac
    shopt -u nullglob

    if [ ${#archives[@]} -eq 0 ]; then
        fail "missing source archive for ${component} in ${source_dir}"
    fi
    if [ ${#archives[@]} -gt 1 ]; then
        printf 'build-client-binary: ambiguous source archives for %s:\n' "${component}" >&2
        printf '  %s\n' "${archives[@]}" >&2
        fail "expected exactly one archive for ${component}"
    fi

    printf '%s\n' "${archives[0]}"
}

extract_source_tarball() {
    if [ ! -d "${source_dir}" ]; then
        mkdir -p $(dirname ${source_dir})
        tar -C $(dirname ${source_dir}) -zxpf ${source_tarball}
    fi
}

gobuild_component() {
    local component=$1
    local parent_component=${2:-$component}
    local extract_path=${3:-"github.com/percona/$parent_component"}
    local component_path=$4
    local result_file=${5:-bin/$(basename ${component_path:-$extract_path})}

    local volume_mounts="-v ${tmp_dir}:/home/builder/tmp"
    volume_mounts+=" -v pmm-gobuild:/home/builder/.cache/go-build"
    volume_mounts+=" -v pmm-gomod:/home/builder/go/pkg/mod"
    volume_mounts+=" -v pmm-dnf:/var/cache/dnf"

    # Set target for Nomad accordingly
    local target
    local goarch
    case "$(uname -m)" in
        x86_64)
            target="linux_amd64"
            goarch="amd64"
            ;;
        aarch64)
            target="linux_arm64"
            goarch="arm64"
            ;;
        *)
            echo "Unsupported architecture: $(uname -m)"
            exit 1
            ;;
    esac

    if [ ${component} = 'azure_metrics_exporter' ]; then
        result_file=${result_file/_metrics/}
    fi

    if [ -x "${binary_dir}/${result_file}" ]; then
        echo skip build
        return
    fi

    local release_fullcommit
    local component_version
    local component_branch
    if [ ${component} = 'vmagent' ]; then
        release_fullcommit=${vmagent_commit_hash}
        component_version=${vmagent_commit_hash:0:6}
        component_branch=${vmagent_commit_hash:0:6}
    elif [ ${component} = 'nomad' ]; then
        release_fullcommit=${nomad_commit_hash}
        component_version=${nomad_commit_hash:0:6}
        component_branch=${nomad_commit_hash:0:6}
    elif [ ${component} = 'redis_exporter' ]; then
        release_fullcommit=${redis_exporter_commit_hash}
        component_version=${redis_exporter_commit_hash:0:6}
        component_branch=${redis_exporter_commit_hash:0:6}
    else
        release_fullcommit=$(cd sources/${parent_component}/src/${extract_path} && git rev-parse HEAD)
        component_version=$(cd sources/${parent_component}/src/${extract_path} && git describe --abbrev=0 --always)
        component_branch=$(cd sources/${parent_component}/src/${extract_path} && git describe --always --contains --all)
    fi

    local build_stamp
    build_stamp=$(date '+%s')
    local build_date
    build_date=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    local component_gopath=/home/builder/tmp/go-build/${component}-${release_fullcommit}-${build_stamp}
    local component_source_dir=${component_gopath}/src/${extract_path}
    local archive
    archive=$(basename "$(component_archive "${parent_component}")")

    if [ ${component} = 'pmm-admin' ]; then
        build_command="cd ${component_source_dir}/${component_path} && make release"
    elif [ ${component} = 'pmm-agent' ]; then
        if [ "${BUILD_TYPE}" = "dynamic" ]; then
            build_command="cd ${component_source_dir}/${component_path} && make release-gssapi"
        else
            build_command="cd ${component_source_dir}/${component_path} && make release"
        fi
    elif [ ${component} = 'mongodb_exporter' ]; then
        if [ "${BUILD_TYPE}" = "dynamic" ]; then
            build_command="cd ${component_source_dir} && make build-gssapi"
        else
            build_command="cd ${component_source_dir} && make build"
        fi
    elif [ ${component} = 'node_exporter' ] || [ ${component} = 'mysqld_exporter' ] || \
         [ ${component} = 'proxysql_exporter' ] || [ ${component} = 'rds_exporter' ] || \
         [ ${component} = 'postgres_exporter' ] || [ ${component} = 'azure_metrics_exporter' ]; then
        if [ ${component} = 'mysqld_exporter' ]; then
            build_command="cd ${component_source_dir} && make GO_BUILD_LDFLAGS=\"-ldflags \\\"\${PROMETHEUS_GO_BUILD_LDFLAGS}\\\"\" release"
        else
            build_command="cd ${component_source_dir} && make GO_BUILD_LDFLAGS=\"\${PROMETHEUS_GO_BUILD_LDFLAGS}\" release"
        fi
    elif [ ${component} = 'percona-toolkit' ]; then
        build_command="cd ${component_source_dir}/${component_path} && go build -o \${binary_dir}/${result_file} ."
    elif [ ${component} = 'nomad' ]; then
        build_command="cd ${component_source_dir} && TARGETS=${target} make GIT_COMMIT=${release_fullcommit} GIT_DIRTY= BUILD_DATE=${build_date} deps release && cp pkg/${target}/nomad \${binary_dir}/${result_file}"
    elif [ ${component} = 'redis_exporter' ]; then
        build_command="cd ${component_source_dir} && go build -o \${binary_dir}/${result_file} ."
    elif [ ${component} = 'clickhouse_exporter' ]; then
        # Built from the pmm module: cd into the repo so module mode resolves
        # deps (cwd outside any module -> GO111MODULE=auto picks GOPATH).
        build_command="cd ${component_source_dir} && go build -o \${binary_dir}/${result_file} ./${component_path}"
    else
        build_command="cd ${component_gopath} && go build -o \${binary_dir}/${result_file} ./src/${extract_path}/${component_path}"
    fi

    docker run --rm ${volume_mounts} ${rpmbuild_docker_image} sh -c "
        set -o errexit
        set -o xtrace
        export GOOS=${GOOS:-linux}
        export GOARCH=${GOARCH:-${goarch}}
        export CGO_ENABLED=0
        export GO111MODULE=auto

        # for 'make release'
        export PMM_RELEASE_VERSION=${full_pmm_version}
        export PMM_RELEASE_TIMESTAMP=$(date '+%s')
        export PMM_RELEASE_FULLCOMMIT=${release_fullcommit}
        export COMPONENT_VERSION=${component_version}
        export COMPONENT_BRANCH=${component_branch}
        export PMM_RELEASE_BRANCH=""
        sudo chown -R builder:builder /home/builder/tmp

        source_dir=/home/builder/tmp/source/pmm-client-${pmm_version}
        binary_dir=/home/builder/tmp/binary/pmm-client-${pmm_version}
        export PMM_RELEASE_PATH=\${binary_dir}/bin

        mkdir -p \$binary_dir/bin

        component_gopath=${component_gopath}
        component_source_dir=${component_source_dir}
        mkdir -p \${component_source_dir}
        archive=${archive}
        tar -C \${component_source_dir} --strip-components=1 -zxpf \${source_dir}/\$archive
        export PROMETHEUS_GO_BUILD_LDFLAGS=\"-X github.com/prometheus/common/version.Version=\${COMPONENT_VERSION} -X github.com/prometheus/common/version.Revision=\${PMM_RELEASE_FULLCOMMIT} -X github.com/prometheus/common/version.Branch=\${COMPONENT_BRANCH} -X github.com/prometheus/common/version.BuildUser= -X github.com/prometheus/common/version.BuildDate=\$(date +%FT%T%z) -s -w\"
        pushd \${component_gopath}
            export GOPATH=\$(pwd -P)
            export PATH=$PATH:\$(go env GOPATH)/bin
            ${build_command}
        popd
        sudo chown -R $(id -u):$(id -g) /home/builder/tmp
    "
}

copy_component() {
    local component=$1
    local component_path=$2
    local component_dest=${3:-$component_path}
    local component_dir=${tmp_dir}/source/${component}
    local archive
    archive=$(component_archive "${component}")

    if [ ! -d "${component_dir}" ]; then
        mkdir -p ${component_dir}
        tar \
            -C ${component_dir} \
            --strip-components=1 \
            -zxpf "$archive"
    fi

    cp -r ${component_dir}/${component_path} ${binary_dir}/${component_dest}
}

main() {
    rm -rf "${binary_dir}"
    extract_source_tarball

    gobuild_component "vmagent" "" "github.com/VictoriaMetrics/VictoriaMetrics" "app/vmagent"
    gobuild_component "nomad" "" "github.com/hashicorp/nomad"
    gobuild_component "redis_exporter" "" "github.com/oliver006/redis_exporter" "" "bin/valkey_exporter"
    gobuild_component "node_exporter" "" "github.com/prometheus/node_exporter"
    gobuild_component "mysqld_exporter"
    gobuild_component "postgres_exporter" "" "" "cmd/postgres_exporter"
    gobuild_component "mongodb_exporter"
    gobuild_component "proxysql_exporter"
    gobuild_component "rds_exporter"
    gobuild_component "azure_metrics_exporter"

    gobuild_component "pmm-admin" "pmm" "" "admin"
    gobuild_component "pmm-agent" "pmm" "" "agent"
    gobuild_component "clickhouse_exporter" "pmm" "" "agent/cmd/clickhouse_exporter"

    echo ${pmm_version} > ${binary_dir}/VERSION

    copy_component "pmm" "build/packages/rpm/client" "rpm"
    copy_component "pmm" "build/packages/config" "config"
    copy_component "pmm" "build/packages/deb" "debian"
    copy_component "pmm" "build/scripts/install_tarball" "install_tarball"
    copy_component "node_exporter" "example.prom"
    copy_component "mysqld_exporter" "queries-mysqld.yml"
    copy_component "mysqld_exporter" "queries-mysqld-group-replication.yml"
    copy_component "postgres_exporter" "example-queries-postgres.yml"
    copy_component "postgres_exporter" "queries-postgres-uptime.yml"
    copy_component "postgres_exporter" "queries-hr.yml"
    copy_component "postgres_exporter" "queries-mr.yaml"
    copy_component "postgres_exporter" "queries-lr.yaml"

    copy_component "percona-toolkit" "bin/pt-summary"
    copy_component "percona-toolkit" "bin/pt-mysql-summary"
    gobuild_component "percona-toolkit" "" "github.com/percona/percona-toolkit" "src/go/pt-mongodb-summary"
    gobuild_component "percona-toolkit" "" "github.com/percona/percona-toolkit" "src/go/pt-pg-summary"

    if [[ "${BUILD_TYPE}" = "dynamic" ]]; then
        rm -f ${dynamic_binary_tarball}
        mkdir -p $(dirname ${dynamic_binary_tarball})
        tar -C $(dirname ${binary_dir}) -zcpf ${dynamic_binary_tarball} $(basename ${binary_dir})
    else
        rm -rf ${binary_tarball}
        mkdir -p $(dirname ${binary_tarball})
        tar -C $(dirname ${binary_dir}) -zcpf ${binary_tarball} $(basename ${binary_dir})
    fi
}

main
exit 0

