#!/bin/bash

set -o errexit
set -o xtrace

. $(dirname $0)/vars

prepare_tarball() {
    local repo_name=$1
    if [ $repo_name = 'pmm-submodules' ]; then
        mkdir -p ${root_dir}/sources/${repo_name}
        git_dir="${root_dir}/sources/${repo_name}"
    else
        # -L: follow symlinks — component sources may be symlinked into the
        # build tree (a standalone layout) rather than being real directories.
        # realpath: canonicalise so `git` resolves the submodule gitlink against
        # the real path, not the symlinked one.
        local git_dir=$(realpath "$(dirname "$(find -L "${root_dir}/sources/${repo_name}" -name .git | head -1)")")
    fi
    local commit=$(git -C "${git_dir}" rev-parse --short HEAD)
    local tarball=${source_dir}/${repo_name}-${commit}.tar.gz
    local repo_var=$(
        echo "${repo_name}_commit" \
            | sed -e 's:-:_:g' \
            | tr '[[:lower:]]' '[[:upper:]]'
    )
    echo "${repo_var}=$commit" >> ${client_properties}

    if [ -f "${tarball}" ]; then
        echo ${tarball} already exists, skipping build
    else
        if [ ${repo_name} = 'pmm-submodules' ]; then
            tar -C sources -zcf ${repo_name}-${commit}.tar.gz  ${repo_name}
            mv ${repo_name}-${commit}.tar.gz  ${source_dir}/
        else
            git -C "${git_dir}" archive \
                --format=tar.gz \
                --prefix=${repo_name}-${commit}/ \
                -o ${tarball} \
                "${commit}"
        fi
    fi
}

prepare_external_tarball() {
    local repo_name=$1
    local commit_hash=$2
    local base_url=$3

    local commit_short=${commit_hash::6}
    local tarball="${source_dir}/${repo_name}-${commit_short}.tar.gz"
    local repo_var=$(
        echo "${repo_name}_commit" \
            | sed -e 's:-:_:g' \
            | tr '[[:lower:]]' '[[:upper:]]'
    )
    echo "${repo_var}=${commit_short}" >> "${client_properties}"

    if [ -f "${tarball}" ]; then
        echo "${tarball} already exists, skipping download"
    else
        curl -fsSL -o "${tarball}" "${base_url}/${commit_hash}.tar.gz"
    fi

    # Initialise a git repo in the extracted directory so build-client-binary
    # can run git rev-parse HEAD (the upstream scripts assume every component
    # is a cloned submodule).
    local extract_dir="${source_dir}/${repo_name}-${commit_short}"
    if [ ! -d "${extract_dir}/.git" ]; then
        mkdir -p "${extract_dir}"
        tar -C "${extract_dir}" --strip-components=1 -zxf "${tarball}" 2>/dev/null || true
        if [ -d "${extract_dir}" ] && [ ! -d "${extract_dir}/.git" ]; then
            git -C "${extract_dir}" init --quiet
            git -C "${extract_dir}" config user.email "build@datacosmos.com.br"
            git -C "${extract_dir}" config user.name "Build Bot"
            git -C "${extract_dir}" add -A
            git -C "${extract_dir}" commit -m "external tarball ${commit_hash}" --quiet
            # Ensure the fake commit matches the hash the build scripts expect.
            git -C "${extract_dir}" --no-pager log --oneline -1
        fi
    fi
}

main() {
    rm -rf ${source_tarball}
    mkdir -p ${source_dir}/ $(dirname ${source_tarball}) || :
    echo "PMM_SUBMODULES_COMMIT=$(git rev-parse --short HEAD)" > ${client_properties}

    # External sources from GitHub
    prepare_external_tarball "vmagent" "${vmagent_commit_hash}" "https://github.com/VictoriaMetrics/VictoriaMetrics/archive"
    prepare_external_tarball "nomad" "${nomad_commit_hash}" "https://github.com/hashicorp/nomad/archive"
    prepare_external_tarball "redis_exporter" "${redis_exporter_commit_hash}" "https://github.com/oliver006/redis_exporter/archive"

    prepare_tarball pmm-submodules
    prepare_tarball pmm
    prepare_tarball mongodb_exporter
    prepare_tarball mysqld_exporter
    prepare_tarball postgres_exporter
    prepare_tarball proxysql_exporter
    prepare_tarball node_exporter
    prepare_tarball rds_exporter
    prepare_tarball azure_metrics_exporter

    prepare_tarball percona-toolkit

    tar -C $(dirname ${source_dir}) -zcpf ${source_tarball} $(basename ${source_dir})
}

main
exit 0

